###############################
# ASP.NET Core API + VS Ignore
###############################

# --- Build Artifacts ---
bin/
obj/

# --- Visual Studio specific ---
.vs/
*.v11.suo
*.suo
*.user
*.userosscache
*.rsuser
*.sln.docstates

# --- NuGet ---
packages/
*.nupkg
.nuget/

# --- Config (safe ignores) ---
appsettings.Development.json
appsettings.Local.json
secrets.json   # for `dotnet user-secrets`

# DO NOT ignore --> appsettings.json (keep it!)

# --- Logs / Cache ---
*.log
*.tlog
*.cache
*.ilk
*.iobj
*.ipdb
*.pdb

# --- Publish output ---
/publish/
/out/

# --- Test Projects ---
TestResults/
*.testsettings
*.vsmdi

# --- Temporary files ---
*.tmp
*.temp
*.bak
*.swp
*.orig

# --- Node (if front-end inside solution folder) ---
node_modules/
npm-debug.log
yarn-error.log

# --- Static build files ---
wwwroot/dist/
wwwroot/build/

# --- OS Garbage ---
.DS_Store
Thumbs.db
ehthumbs.db

# --- Dotnet Tools ---
.dotnet_tools/
