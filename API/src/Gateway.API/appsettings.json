{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Jwt": {
    "Key": "SuperSecretKeyForDevelopmentOnlyReplaceInProduction",
    "Issuer": "GraduationProjectAPI",
    "Audience": "GraduationProjectClient"
  },
  "ReverseProxy": {
    "Routes": {
      "webapi-route": {
        "ClusterId": "webapi-cluster",
        "Match": {
          "Path": "{**catch-all}"
        },
        "Transforms": [
          {
            "RequestHeader": "X-Forwarded-Host",
            "Set": "{Host}"
          }
        ]
      }
    },
    "Clusters": {
      "webapi-cluster": {
        "Destinations": {
          "webapi-destination": {
            "Address": "https://localhost:5030"
          }
        }
      }
    }
  }
}
